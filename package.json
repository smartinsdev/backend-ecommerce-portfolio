{
  "name": "backend-ecommerce-ddd-design",
  "version": "1.0.0",
  "private": "true",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "node --experimental-transform-types --watch-path=./src src/index.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "ci": "biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "biome check && tsc -p tsconfig.check.json"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "name": "backend-ecommerce-ddd-design",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "ci": "biome ci .",
    "validate": "biome check && tsc -p tsconfig.check.json",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:update": "prisma db update -y",
    "db:test:update": "NODE_ENV=test prisma db update -y"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "prisma": "8.0.0-rc.22",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "dotenv": "^18.0.7",
    "zod": "^4.6.5"
  }
}
